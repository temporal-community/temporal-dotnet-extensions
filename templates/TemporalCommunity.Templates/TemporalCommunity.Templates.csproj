<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>TemporalCommunity.Templates</PackageId>
    <Description>dotnet new templates for Temporal .NET: item templates for a workflow, an activity, and a payload converter with a custom encoding; a single-project worker host; and a Worker + Client + Shared solution with optional .NET Aspire orchestration and OpenTelemetry tracing.</Description>
    <PackageTags>temporal;dotnet-new;templates;workflow;activity;worker;encoding-converter;payload-converter;aspire;opentelemetry;scaffolding</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- PackageType=Template projects intentionally ship no lib/ output; NuGet's dependency/TFM
         consistency check otherwise flags that as a mismatch. Confirmed against the real
         Aspire.ProjectTemplates.csproj, which suppresses the same warning for the same reason. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK default globbing has no built-in exclusion for a folder literally named "content" —
         without this, .cs files under content/** get compiled into this (non-runnable) packing
         project and fail the build. -->
    <Compile Remove="content/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- IncludeContentInPack/ContentTargetFolders alone do not itemize arbitrary files under
         content/ as packed Content — this explicit item is required or `dotnet pack` fails with
         NU5017 ("Cannot create a package that has no dependencies nor content"). -->
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" Pack="true" PackagePath="content" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same remapping pattern as TemporalCommunity.Extensions.Analyzers.csproj: a docs file
         doubles as the package README, and the existing DurableObjects icon is reused rather than
         duplicated. -->
    <None Include="..\..\docs\TEMPLATES.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\src\TemporalCommunity.DurableObjects\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
