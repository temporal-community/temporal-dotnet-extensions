{
  "$schema": "http://json.schemastore.org/template",
  "author": "Temporal Community",
  "classifications": [
    "Temporal",
    "Worker",
    "Console"
  ],
  "name": "Temporal Worker",
  "generatorVersions": "[1.0.0.0-*)",
  "description": "Creates a single console-host project running a Temporal worker (Temporalio.Extensions.Hosting), with a resolved TemporalClientConnectOptions (env/profile -> Temporal:Address config -> localhost:7233) and optional OpenTelemetry tracing.",
  "groupIdentity": "TemporalCommunity.Templates.Project.Worker",
  "precedence": "0",
  "identity": "TemporalCommunity.Templates.Project.Worker.CSharp",
  "shortName": "temporal-worker",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "TemporalWorker1",
  "preferNameDirectory": true,
  "defaultName": "TemporalWorker1",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0",
          "description": "Target net8.0"
        },
        {
          "choice": "net10.0",
          "description": "Target net10.0"
        }
      ],
      "replaces": "net8.0",
      "defaultValue": "net10.0",
      "displayName": "Framework"
    },
    "IncludeOtel": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Include OpenTelemetry tracing",
      "description": "Adds the Temporal SDK tracing sources, the client-side TracingInterceptor, and an OTLP exporter gated on the OTEL_EXPORTER_OTLP_ENDPOINT environment variable."
    },
    "kestrelHttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json when --api is used."
    },
    "kestrelHttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "kestrelHttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "kestrelHttpPort",
        "fallbackVariableName": "kestrelHttpPortGenerated"
      },
      "replaces": "5000",
      "onlyIf": [{
        "after": "localhost:"
      }]
    },
    "kestrelHttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTPS endpoint in launchSettings.json when --api is used."
    },
    "kestrelHttpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    },
    "kestrelHttpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "kestrelHttpsPort",
        "fallbackVariableName": "kestrelHttpsPortGenerated"
      },
      "replaces": "7000",
      "onlyIf": [{
        "after": "localhost:"
      }]
    },
    "UseMinimalApi": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Use ASP.NET Core minimal API host",
      "description": "Uses WebApplication.CreateBuilder and the Web SDK instead of the default Generic Host console setup."
    }
  },
  "primaryOutputs": [
    {
      "path": "TemporalWorker1.csproj"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
