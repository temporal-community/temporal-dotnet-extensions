<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pinned here, in exactly one place, so bumping the analyzer package is a one-line change,
         independent of this template package's own MinVer-derived version. -->
    <TemporalCommunityAnalyzersVersion>0.3.4</TemporalCommunityAnalyzersVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.17.0" />
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="TemporalCommunity.Extensions.Analyzers" Version="$(TemporalCommunityAnalyzersVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!--#if (IncludeOtel) -->
  <ItemGroup>
    <PackageReference Include="Temporalio.Extensions.OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>
  <!--#endif -->

</Project>
