<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.20.0" />
    <!-- Temporalio.Extensions.Hosting provides AddTemporalClient, which Program.cs uses to register
         ITemporalClient the same way Worker does. Microsoft.Extensions.Hosting stays referenced
         directly because Client builds on the Generic Host (config, DI, logging) and pins that
         version itself rather than relying on the transitive one. -->
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <!--#if (IncludeOtel) -->
  <ItemGroup>
    <PackageReference Include="Temporalio.Extensions.OpenTelemetry" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>
  <!--#endif -->

  <!--#if (OtelWithoutAspire) -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>
  <!--#endif -->

  <ItemGroup>
    <ProjectReference Include="..\XmlEncodedProjectName.Shared\XmlEncodedProjectName.Shared.csproj" />
<!--#if (IncludeAspire) -->
    <ProjectReference Include="..\XmlEncodedProjectName.ServiceDefaults\XmlEncodedProjectName.ServiceDefaults.csproj" />
<!--#endif -->
  </ItemGroup>

</Project>
