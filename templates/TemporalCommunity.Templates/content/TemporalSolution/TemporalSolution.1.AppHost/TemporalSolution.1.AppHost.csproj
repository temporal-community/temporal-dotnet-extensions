<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- No explicit Aspire.Hosting.AppHost PackageReference — the Aspire.AppHost.Sdk MSBuild SDK
         reference above already supplies it (confirmed against the real Aspire.ProjectTemplates
         AppHost.csproj, which only adds explicit PackageReferences for specific integrations
         actually used, e.g. Aspire.Hosting.Redis). TemporalCommunity.Aspire.Hosting is that kind
         of specific integration. -->
    <PackageReference Include="TemporalCommunity.Aspire.Hosting" Version="0.4.0" />
    <!-- Aspire integration accepts Temporalio >= 1.17.0; pin the AppHost graph to the same
         SDK as Worker/Client/Shared instead of resolving its transitive minimum. -->
    <PackageReference Include="Temporalio" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XmlEncodedProjectName.Worker\XmlEncodedProjectName.Worker.csproj" />
    <ProjectReference Include="..\XmlEncodedProjectName.Client\XmlEncodedProjectName.Client.csproj" />
  </ItemGroup>

</Project>
