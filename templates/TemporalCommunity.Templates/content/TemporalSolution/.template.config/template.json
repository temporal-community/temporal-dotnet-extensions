{
  "$schema": "http://json.schemastore.org/template",
  "author": "Temporal Community",
  "classifications": [
    "Temporal",
    "Worker",
    "Cloud",
    "Aspire"
  ],
  "name": "Temporal Solution (Worker + Client + Shared)",
  "generatorVersions": "[1.0.0.0-*)",
  "description": "Creates a Worker + Client + Shared multi-project solution running plain Temporalio workflows/activities, with optional .NET Aspire orchestration (AppHost + ServiceDefaults, auto-provisioning a local Temporal dev server) and optional OpenTelemetry tracing.",
  "groupIdentity": "TemporalCommunity.Templates.Project.Solution",
  "precedence": "0",
  "identity": "TemporalCommunity.Templates.Project.Solution.CSharp",
  "shortName": "temporal-solution",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "TemporalSolution.1",
  "preferNameDirectory": false,
  "defaultName": "TemporalSolution.1",
  "guids": [
    "EE7369E1-6101-455F-8ECC-0A4D83339A10",
    "BBDCEDE6-14B7-4FB5-9B13-8F2FA0A1F224",
    "0C530E8C-096E-465D-BB11-93348A245B81",
    "C5303D9B-2C05-4786-9DDB-3F6CEDD6736D",
    "F2D16E20-35DD-431E-ACA7-CFDFE8E2D80A",
    "40643D24-CD4E-45ED-A105-D4F496C5975E"
  ],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(hostIdentifier != \"dotnetcli\" && hostIdentifier != \"dotnetcli-preview\")",
          "exclude": [ "*.sln" ]
        },
        {
          "condition": "(!IncludeAspire)",
          "exclude": [
            "TemporalSolution.1.AppHost/**",
            "TemporalSolution.1.ServiceDefaults/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "hostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "Framework": {
      "type": "parameter",
      "description": "The target framework for every generated project: Worker, Client, Shared, and — when --include-aspire is used — the AppHost and ServiceDefaults projects.",
      "datatype": "choice",
      "choices": [
        { "choice": "net8.0", "description": "Target net8.0" },
        { "choice": "net10.0", "description": "Target net10.0" }
      ],
      "replaces": "net8.0",
      "defaultValue": "net10.0",
      "displayName": "Framework"
    },
    "IncludeAspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Include .NET Aspire orchestration",
      "description": "Adds an AppHost and ServiceDefaults project. AppHost auto-provisions a local Temporal dev server via TemporalCommunity.Aspire.Hosting."
    },
    "IncludeOtel": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Include OpenTelemetry tracing",
      "description": "Adds a 'Temporalio' ActivitySource and the client-side TracingInterceptor to Worker and Client. When IncludeAspire is false, also adds a standalone OTLP exporter gated on OTEL_EXPORTER_OTLP_ENDPOINT."
    },
    "OtelWithoutAspire": {
      "type": "computed",
      "value": "(IncludeOtel == true && IncludeAspire == false)"
    },
    "GeneratedNamespacePrefix": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "replaces": "GeneratedNamespacePrefix",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "(?<=\\.)\\.|^\\.|\\.$",
            "replacement": "_"
          },
          {
            "regex": "[^\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}\\p{Cf}.]",
            "replacement": "_"
          },
          {
            "regex": "((?<=\\.)|^)(?=[^_\\p{L}\\p{Nl}])",
            "replacement": "_"
          },
          {
            "regex": "((?<=\\.)|^)(?=(?:__arglist|__makeref|__reftype|__refvalue|abstract|as|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|virtual|void|volatile|while)(?:\\.|\\z))",
            "replacement": "@"
          }
        ]
      }
    },
    "GeneratedAspirePrefix": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "replaces": "GeneratedAspirePrefix",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "(((?<=\\.)|^)(?=\\d)|\\W)",
            "replacement": "_"
          }
        ]
      }
    },
    "XmlEncodedProjectName": {
      "type": "derived",
      "datatype": "string",
      "replaces": "XmlEncodedProjectName",
      "valueSource": "name",
      "valueTransform": "xmlEncode"
    }
  },
  "primaryOutputs": [
    {
      "path": "TemporalSolution.1.sln",
      "condition": "(hostIdentifier == \"dotnetcli\" || hostIdentifier == \"dotnetcli-preview\")"
    },
    { "path": "TemporalSolution.1.Worker/TemporalSolution.1.Worker.csproj" },
    { "path": "TemporalSolution.1.Client/TemporalSolution.1.Client.csproj" },
    { "path": "TemporalSolution.1.Shared/TemporalSolution.1.Shared.csproj" },
    {
      "path": "TemporalSolution.1.AppHost/TemporalSolution.1.AppHost.csproj",
      "condition": "(IncludeAspire)"
    },
    {
      "path": "TemporalSolution.1.ServiceDefaults/TemporalSolution.1.ServiceDefaults.csproj",
      "condition": "(IncludeAspire)"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
