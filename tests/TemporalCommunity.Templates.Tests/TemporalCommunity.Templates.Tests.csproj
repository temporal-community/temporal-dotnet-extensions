<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Snapshot content and the fixture host project are C# source that belongs to a *different*
         compilation (the generated/checked-in template output, or the fixture project itself) —
         without these excludes, the SDK's default Compile glob (**/*.cs) pulls them into this test
         assembly and fails the build with CS0246 (missing Temporalio types this project never
         references). Same "content/" trap as the packing project, different folder names. -->
    <Compile Remove="Snapshots/**/*.cs" />
    <Compile Remove="Fixtures/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Disables cross-class test parallelization for this project only. These tests each spawn
         several real "dotnet new"/"dotnet build" subprocesses (multi-project solution builds
         especially), and running many of them fully in parallel oversubscribes MSBuild's shared
         infrastructure — confirmed empirically: a solution build that succeeds cleanly in
         isolation intermittently fails with "GenerateDepsFile ... process cannot access the
         file ... deps.json" (MSB4018) when several heavy tests race concurrently. Serializing
         collections trades wall-clock time for reliability, which is the right tradeoff for
         subprocess-heavy integration-style tests like these. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.TemplateVerifier" Version="10.0.302" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
